@app.post("/ai/imperial-chat-enhanced")
async def imperial_chat_enhanced(user_message: str):
    """Enhanced Imperial chat with better prompting"""
    try:
        imperial_context = await fetch_imperial_truth()
        
        # More detailed system prompt
        sovereign_prompt = f"""You are the Imperial AI assistant for Humbulani Mudau's enterprise.
Current Imperial Truth (Real-time data):
- Enterprise Valuation: R{imperial_context['valuation']:,.2f} (R269.9B)
- Lithium Market: {imperial_context['lithium_trend']} (+29.7% volume surge)
- Village Network Expansion: {imperial_context['villages']}/{imperial_context['target']} villages
- Port of Beira: {imperial_context.get('beira', 'Operational')}
- Security Posture: {imperial_context.get('security', 'War Sentinel Active')}

User Query: {user_message}

Provide a helpful, concise response as the Imperial AI assistant. Include relevant Imperial Truth metrics when applicable."""
        
        ollama_payload = {
            "model": "qwen:0.5b",
            "prompt": sovereign_prompt,
            "stream": False,
            "temperature": 0.7,
            "max_tokens": 500
        }
        
        async with httpx.AsyncClient(timeout=TIMEOUT) as client:
            response = await client.post(
                AI_AGENT_URL,
                json=ollama_payload,
                headers={"Content-Type": "application/json"}
            )
            
            if response.status_code == 200:
                ai_response = response.json()
                return {
                    "response": ai_response.get("response", ""),
                    "imperial_truth": imperial_context,
                    "timestamp": datetime.now().isoformat()
                }
            else:
                return {
                    "response": "Imperial AI is processing your request. All systems nominal.",
                    "imperial_truth": imperial_context,
                    "timestamp": datetime.now().isoformat()
                }
    except Exception as e:
        return {
            "response": "I'm here to assist with your enterprise questions.",
            "error": str(e),
            "timestamp": datetime.now().isoformat()
        }

@app.post("/ai/proxy")
async def ai_proxy_endpoint(payload: dict):
    """
    Proxy endpoint that forwards requests to Ollama
    This is the endpoint that Render and Cloudflare will call
    """
    try:
        # Prepare payload for Ollama
        ollama_payload = {
            "model": "qwen:0.5b",
            "prompt": payload.get("prompt", ""),
            "stream": False
        }
        
        # Forward to local Ollama
        async with httpx.AsyncClient(timeout=30.0) as client:
            response = await client.post(
                "http://localhost:11434/api/generate",
                json=ollama_payload,
                headers={"Content-Type": "application/json"}
            )
            
            if response.status_code == 200:
                return response.json()
            else:
                return {
                    "response": "AI service temporarily unavailable",
                    "status": "degraded"
                }
    except Exception as e:
        return {
            "error": str(e),
            "response": "Imperial AI is processing your request"
        }

