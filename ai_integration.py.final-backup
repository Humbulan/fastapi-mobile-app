                headers={"Content-Type": "application/json"}
            )
            
            if response.status_code == 200:
                return response.json()
            else:
                return {
                    "response": "AI service temporarily unavailable",
                    "status": "degraded"
                }
    except Exception as e:
        return {
            "error": str(e),
            "response": "Imperial AI is processing your request"
        }

