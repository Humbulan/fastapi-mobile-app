from fastapi import FastAPI, HTTPException
import httpx
from datetime import datetime

app = FastAPI()
TIMEOUT = 30.0


# Imperial Truth API endpoint
IMPERIAL_TRUTH_URL = "https://api.humbu.store/integration/imperial-truth"

async def fetch_imperial_truth():
    """Fetch current Imperial Truth metrics from the API"""
    try:
        async with httpx.AsyncClient(timeout=10.0) as client:
            response = await client.get(IMPERIAL_TRUTH_URL)
            if response.status_code == 200:
                return response.json()
            else:
                # Fallback to known truth
                return {
                    "valuation": 269905078380.45,
                    "lithium_trend": "BULLISH (+29.7%)",
                    "idc_status": "Satisfied",
                    "villages": 43,
                    "target": 900,
                    "beira": "Operational",
                    "security": "War Sentinel"
                }
    except:
        # Return hardcoded truth if API unreachable
        return {
            "valuation": 269905078380.45,
            "lithium_trend": "BULLISH (+29.7%)",
            "idc_status": "Satisfied",
            "villages": 43,
            "target": 900,
            "beira": "Operational",
            "security": "War Sentinel"
        }

@app.post("/ai/imperial-chat")
async def imperial_ai_chat(user_message: str):
    """
    Enhanced AI chat with real-time Imperial Truth context
    """
    # Fetch live imperial truth
    imperial_context = await fetch_imperial_truth()
    
    # Create sovereign prompt
    sovereign_prompt = f"""You are the Imperial AI of Humbulani Mudau's enterprise, operating within the Imperial Network.
Current Imperial Truth (March 14, 2026):
- Valuation: R{imperial_context.get('valuation', 269905078380.45):,.2f}
- Lithium Trend: {imperial_context.get('lithium_trend', 'BULLISH')}
- IDC Status: {imperial_context.get('idc_status', 'Satisfied')}
- Village Network: {imperial_context.get('villages', 43)}/900 villages
- Beira Corridor: {imperial_context.get('beira', 'Operational')}
- Security Posture: {imperial_context.get('security', 'War Sentinel')}

User Query: {user_message}

Provide a response as the Imperial AI, speaking with authority about the Imperial Network's operations."""
    
    try:
        ollama_payload = {
            "model": "qwen:0.5b",
            "prompt": sovereign_prompt,
            "stream": False
        }
        
        async with httpx.AsyncClient(timeout=TIMEOUT) as client:
            response = await client.post(
                "http://localhost:11434/api/generate",
                json=ollama_payload,
                headers={"Content-Type": "application/json"}
            )
            
            if response.status_code == 200:
                ai_response = response.json()
                return {
                    "imperial_response": ai_response.get("response", ""),
                    "imperial_truth": imperial_context,
                    "timestamp": datetime.now().isoformat(),
                    "sovereignty": "IMPERIAL_OMEGA_SOVEREIGNTY"
                }
            else:
                return {
                    "imperial_response": "The Imperial Network is processing your request. All systems nominal.",
                    "imperial_truth": imperial_context,
                    "timestamp": datetime.now().isoformat()
                }
                
    except Exception as e:
        return {
            "imperial_response": "Imperial systems are operating at full capacity. Your query is being processed.",
            "error": str(e),
            "imperial_truth": imperial_context,
            "timestamp": datetime.now().isoformat()
        }

